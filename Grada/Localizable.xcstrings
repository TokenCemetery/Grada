    "Effort Load" : {
      "comment" : "Effort rating × workout minutes (session RPE)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anstrengungslast"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga de esfuerzo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge d’effort"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एफ़र्ट लोड"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carico di sforzo"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga de esforço"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
