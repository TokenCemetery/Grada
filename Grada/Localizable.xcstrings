            "state" : "translated",
            "value" : "Die letzten Tage sind bereit. Ältere Daten laden weiter, während du die App nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días recientes están listos. Los datos más antiguos siguen cargando mientras usas la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours récents sont prêts. Les données plus anciennes continuent de se charger pendant que vous utilisez l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल के दिन तैयार हैं। ऐप इस्तेमाल करते समय पुराना डेटा लोड होता रहता है।"
          }
