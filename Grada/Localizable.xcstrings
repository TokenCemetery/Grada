        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सप्ताह का लोड आपके 4-सप्ताह के औसत का %1$@× है। जब यह %2$@× पर रहा, एथलीटों को सबसे कम चोटें लगीं।"
