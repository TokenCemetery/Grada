          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Garmin pediu ao Grada que diminuísse o ritmo. O Grada tentará novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garmin попросил Grada снизить частоту запросов. Grada повторит попытку позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
