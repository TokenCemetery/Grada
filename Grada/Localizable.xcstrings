    "For %@ of sleep before your %@ at %@, plus the %@ you usually lie awake." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ Schlaf vor deinem %@ um %@, plus die %@, die du üblicherweise wach liegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para %@ de sueño antes de tu %@ a las %@, más los %@ que sueles pasar despierto en la cama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour %@ de sommeil avant votre %@ à %@, plus les %@ que vous restez habituellement éveillé au lit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ पर आपके %2$@ से पहले %1$@ की नींद के लिए, साथ ही वह %4$@ जो आप आमतौर पर जागते लेटे रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per %1$@ di sonno prima del tuo %2$@ alle %3$@, più i %4$@ in cui di solito resti sveglio a letto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para %1$@ de sono antes de %2$@ às %3$@, mais os %4$@ em que você costuma ficar deitado acordado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы поспать %@ до %@ в %@, плюс %@, которые вы обычно лежите без сна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %3$@ 就寝（%2$@）之前睡 %1$@，再加上你通常躺在床上醒着的 %4$@。"
          }
        }
      }
    },
    "For %@ of sleep before your %@ at %@." : {
