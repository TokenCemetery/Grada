    "Notifications are off for Grada. Turn them on in the Settings app › Notifications › Grada." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind für Grada ausgeschaltet. Aktiviere sie in der Einstellungen-App › Mitteilungen › Grada."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas para Grada. Actívalas en la app Ajustes › Notificaciones › Grada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées pour Grada. Activez-les dans l’app Réglages › Notifications › Grada."
          }
        },
        "hi" : {
