    "Select Create Key, read and accept Garmin's terms, and choose how long the key lasts. When it expires, Grada asks for a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Schlüssel erstellen“, lies und akzeptiere die Bedingungen von Garmin und wähle, wie lange der Schlüssel gültig ist. Läuft er ab, bittet Grada um einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona Create Key, lee y acepta los términos de Garmin y elige cuánto dura la clave. Cuando caduque, Grada te pedirá una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez Créer une clé, lisez et acceptez les conditions de Garmin, puis choisissez la durée de validité de la clé. À son expiration, Grada vous en demande une nouvelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create Key चुनें, Garmin की शर्तें पढ़कर स्वीकार करें, और चुनें कि कुंजी कितने समय चले। एक्सपायर होने पर Grada नई माँगेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona Crea chiave, leggi e accetta i termini di Garmin e scegli per quanto tempo la chiave resta valida. Quando scade, Grada ne chiede una nuova."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione Criar chave, leia e aceite os termos da Garmin e escolha por quanto tempo a chave dura. Quando expirar, o Grada pedirá uma nova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Create Key», прочитайте и примите условия Garmin и выберите срок действия ключа. Когда он истечёт, Grada попросит новый."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“创建密钥”，阅读并接受 Garmin 的条款，然后选择密钥的有效期。过期后，Grada 会请你提供新密钥。"
          }
        }
      }
    },
