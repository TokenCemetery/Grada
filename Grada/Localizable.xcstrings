    "Each threshold comes from the studies above. Counting inputs off into Good, Fair and Poor is Grada's choice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schwellenwert stammt aus den oben genannten Studien. Dass nicht erfüllte Indikatoren in Gut, Mittel und Schlecht zusammengezählt werden, ist die Entscheidung von Grada."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada umbral procede de los estudios anteriores. Contar las entradas fuera de rango como Bueno, Regular y Malo es decisión de Grada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque seuil provient des études ci-dessus. Compter les entrées hors plage en Bon, Moyen et Mauvais est un choix de Grada."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सीमा ऊपर दिए अध्ययनों से आती है। सीमा से बाहर इनपुट को अच्छा, ठीक और खराब में गिनना Grada का चुनाव है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni soglia deriva dagli studi sopra citati. Tradurre i parametri fuori norma in Buono, Discreto e Scarso è una scelta di Grada."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada limite vem dos estudos acima. Classificar os critérios em Bom, Regular e Ruim é uma escolha do Grada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый порог взят из перечисленных выше исследований. То, как отклонения превращаются в «Хорошо», «Нормально» и «Плохо», — выбор Grada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个阈值均来自上述研究。将输入项划分为良好、一般和较差是 Grada 的选择。"
          }
        }
      }
    },
