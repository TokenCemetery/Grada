            "value" : "%@ pasos hoy, %@ más que tu objetivo de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pas aujourd’hui, soit %@ de plus que votre objectif de %@."
