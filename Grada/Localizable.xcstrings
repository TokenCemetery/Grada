    "Garmin asked Grada to slow down. Grada will try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garmin hat Grada gebeten, langsamer zu machen. Grada versucht es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garmin ha pedido a Grada que vaya más despacio. Grada lo intentará de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garmin a demandé à Grada de ralentir. Grada réessaiera plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garmin ने Grada से धीमा होने को कहा। Grada बाद में फिर कोशिश करेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
