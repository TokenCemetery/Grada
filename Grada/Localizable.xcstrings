    "BMI uses the latest height in Apple Health for every day, since adult height barely changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der BMI verwendet für jeden Tag die neueste Größe aus Apple Health, da sich die Größe Erwachsener kaum ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC usa la altura más reciente de Apple Health para cada día, ya que la altura de un adulto apenas cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IMC utilise la taille la plus récente d’Apple Health pour chaque jour, car la taille d’un adulte change à peine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI हर दिन के लिए Apple Health में सबसे नई लंबाई लेता है, क्योंकि वयस्कों की लंबाई लगभग नहीं बदलती।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IMC usa l’altezza più recente in Apple Health per ogni giorno, perché l’altezza di un adulto cambia appena."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IMC usa a altura mais recente do Apple Health para cada dia, já que a altura de um adulto quase não muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИМТ использует для каждого дня последний рост из Apple Health: рост взрослого почти не меняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI 每天都使用 Apple Health 中最新的身高，因为成年人的身高几乎不变。"
          }
        }
      }
    },
