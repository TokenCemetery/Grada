    "Steps taken during the day. Around 7,000–10,000 a day is linked with better long-term health." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während des Tages gegangene Schritte. Etwa 7.000–10.000 pro Tag werden mit besserer langfristiger Gesundheit in Verbindung gebracht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasos dados durante el día. Unos 7.000–10.000 al día se asocian con mejor salud a largo plazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas effectués dans la journée. Environ 7 000 à 10 000 par jour sont associés à une meilleure santé à long terme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन भर में उठाए गए कदम। रोज़ लगभग 7,000–10,000 कदम बेहतर दीर्घकालिक स्वास्थ्य से जुड़े हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passi fatti durante il giorno. Circa 7.000–10.000 al giorno sono associati a una migliore salute a lungo termine."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passos dados durante o dia. Cerca de 7.000–10.000 por dia estão associados a melhor saúde a longo prazo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаги за день. Около 7 000–10 000 шагов в день связано с лучшим здоровьем в долгосрочной перспективе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白天走的步数。每天约 7,000–10,000 步与更好的长期健康相关。"
          }
        }
      }
    },
