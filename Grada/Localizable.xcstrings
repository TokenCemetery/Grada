    "150 moderate or 75 vigorous minutes a week, so a vigorous minute counts as two" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "150 mäßig intensive oder 75 intensive Minuten pro Woche, eine intensive Minute zählt also doppelt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "150 minutos moderados o 75 vigorosos a la semana, así que un minuto vigoroso cuenta doble"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "150 minutes modérées ou 75 intenses par semaine, une minute intense comptant double"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सप्ताह में 150 मध्यम या 75 तीव्र मिनट, इसलिए एक तीव्र मिनट दो गिना जाता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "150 minuti moderati o 75 intensi a settimana: un minuto intenso ne vale due"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "150 minutos moderados ou 75 vigorosos por semana; um minuto vigoroso conta como dois"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "150 минут умеренной или 75 минут интенсивной активности в неделю, поэтому интенсивная минута считается за две"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周 150 分钟中等强度或 75 分钟高强度运动，因此 1 分钟高强度按 2 分钟计算"
          }
        }
      }
    },
