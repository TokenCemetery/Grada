    },
    "Resting heart rate %@ bpm is above your normal %@–%@. It rises with illness, stress, alcohol and too little recovery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ruhepuls von %@ bpm liegt über deinem Normbereich von %@–%@. Er steigt bei Krankheit, Stress, Alkohol und zu wenig Erholung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu frecuencia cardíaca en reposo de %@ bpm está por encima de tu rango normal de %@–%@. Sube con la enfermedad, el estrés, el alcohol y la falta de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence cardiaque au repos de %@ bpm est au-dessus de votre normale de %@–%@. Elle augmente avec la maladie, le stress, l’alcool et un manque de récupération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विश्राम हृदय गति %1$@ bpm आपके सामान्य %2$@–%3$@ से ऊपर है। यह बीमारी, तनाव, शराब और कम रिकवरी से बढ़ती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frequenza cardiaca a riposo di %@ bpm è sopra il tuo normale di %@–%@. Aumenta con malattia, stress, alcol e recupero insufficiente."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frequência cardíaca em repouso de %1$@ bpm está acima do seu normal de %2$@–%3$@. Ela sobe com doença, estresse, álcool e pouca recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пульс покоя %@ уд/мин выше вашей нормы %@–%@. Он растёт при болезни, стрессе, алкоголе и недостатке восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静息心率 %1$@ bpm 高于你的正常范围 %2$@–%3$@。生病、压力、饮酒和恢复不足都会使其升高。"
          }
        }
      }
    },
    "Resting heart rate rising above its personal baseline before symptoms of illness" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhepuls steigt vor Krankheitssymptomen über seinen persönlichen Basiswert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia cardíaca en reposo sube por encima de su referencia personal antes de los síntomas de enfermedad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence cardiaque au repos qui dépasse sa base personnelle avant les symptômes d’une maladie"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीमारी के लक्षणों से पहले विश्राम हृदय गति का अपनी निजी बेसलाइन से ऊपर बढ़ना"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza cardiaca a riposo che supera la propria base personale prima dei sintomi di una malattia"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequência cardíaca em repouso acima da sua referência pessoal antes de sintomas de doença"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рост пульса покоя выше личного базового уровня до появления симптомов болезни"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静息心率在出现疾病症状之前高于其个人基线"
          }
        }
      }
    },
