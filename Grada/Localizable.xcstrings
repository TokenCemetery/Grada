            "value" : "HRV erholt sich nach leichtem Training in 24 Stunden, nach Schwellentraining in 24–48, nach hartem in 48+"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El HRV se recupera en 24 horas tras ejercicio suave, en 24–48 tras esfuerzo umbral y en 48+ tras esfuerzo intenso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VFC se rétablit en 24 h après un exercice facile, 24 à 48 h après un effort au seuil, 48 h et plus après un effort intense"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV हल्के व्यायाम के बाद 24 घंटे में, थ्रेशोल्ड के बाद 24–48 में, कठिन के बाद 48+ में रिकवर होता है"
