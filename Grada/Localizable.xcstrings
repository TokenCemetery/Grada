    },
    "What it means" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was es bedeutet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué significa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que cela signifie"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका मतलब"
          }
        },
        "it" : {
          "stringUnit" : {
