    "Ovulation followed the first rise in luteinizing hormone by 16–48 hours in 90% of cycles" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 90 % der Zyklen folgte der Eisprung 16–48 Stunden nach dem ersten Anstieg des luteinisierenden Hormons"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el 90 % de los ciclos, la ovulación llegó 16–48 horas después del primer aumento de la hormona luteinizante"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans 90 % des cycles, l’ovulation a suivi de 16 à 48 heures la première hausse de l’hormone lutéinisante"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90% चक्रों में ओव्यूलेशन ल्यूटिनाइज़िंग हार्मोन की पहली वृद्धि के 16–48 घंटे बाद हुआ"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel 90% dei cicli l’ovulazione è arrivata 16–48 ore dopo il primo aumento dell’ormone luteinizzante"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em 90% dos ciclos, a ovulação ocorreu 16–48 horas após o primeiro aumento do hormônio luteinizante"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В 90 % циклов овуляция наступала через 16–48 часов после первого подъёма лютеинизирующего гормона"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90% 的周期中，排卵发生在黄体生成素首次升高后的 16–48 小时内"
          }
        }
      }
    },
