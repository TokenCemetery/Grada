    "Breaths per minute while asleep. It's very stable from night to night, so a rise above your normal is an early sign of illness or strain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atemzüge pro Minute im Schlaf. Sie ist von Nacht zu Nacht sehr stabil, ein Anstieg über deinen Normalwert ist daher ein frühes Zeichen für Krankheit oder Belastung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiraciones por minuto durante el sueño. Es muy estable de una noche a otra, así que una subida por encima de lo normal es una señal temprana de enfermedad o sobrecarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirations par minute pendant le sommeil. Elle est très stable d’une nuit à l’autre : une hausse au-dessus de votre normale est un signe précoce de maladie ou de fatigue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोते समय प्रति मिनट साँसें। यह रात-दर-रात बहुत स्थिर रहती है, इसलिए सामान्य से ऊपर बढ़ना बीमारी या तनाव का शुरुआती संकेत है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiri al minuto durante il sonno. È molto stabile da una notte all’altra, quindi un aumento oltre il tuo normale è un segnale precoce di malattia o affaticamento."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirações por minuto durante o sono. É muito estável de uma noite para outra, então um aumento acima do seu normal é um sinal precoce de doença ou esforço excessivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Число вдохов в минуту во сне. Оно очень стабильно от ночи к ночи, поэтому рост выше вашей нормы — ранний признак болезни или перегрузки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠期间每分钟的呼吸次数。它每晚都非常稳定，因此高于你的正常水平是疾病或身体负担的早期信号。"
          }
        }
      }
    },
    "Build back up gradually" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baue allmählich wieder auf"
