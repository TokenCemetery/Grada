    "Without a cool-down the cut-off was 18 bpm; recovery still predicted mortality" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Auslaufen lag der Grenzwert bei 18 bpm; die Erholung sagte weiterhin Sterblichkeit voraus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin enfriamiento el umbral fue de 18 ppm; la recuperación siguió prediciendo la mortalidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans retour au calme, le seuil était de 18 bpm ; la récupération prédisait toujours la mortalité"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठंडा होने के बिना सीमा 18 bpm थी; रिकवरी से फिर भी मृत्यु दर का अनुमान लगा"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza defaticamento la soglia era 18 bpm; il recupero prediceva comunque la mortalità"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem desaquecimento o limite foi de 18 bpm; a recuperação ainda previu a mortalidade"
