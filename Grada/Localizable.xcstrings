            "state" : "translated",
            "value" : "Objetivos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objectifs"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiettivi"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цели"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标"
          }
        }
      }
    },
    "Goals adjust every Monday from your progress, and sleep follows your Sleep need. Change them any time in Settings › Goals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele werden jeden Montag anhand deines Fortschritts angepasst, und Schlaf folgt deinem Schlafbedarf. Ändere sie jederzeit unter Einstellungen › Ziele."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los objetivos se ajustan cada lunes según tu progreso, y el de sueño sigue tu necesidad de sueño. Cámbialos cuando quieras en Ajustes › Objetivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les objectifs s’ajustent chaque lundi selon vos progrès, et le sommeil suit votre besoin de sommeil. Modifiez-les à tout moment dans Réglages › Objectifs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य हर सोमवार आपकी प्रगति के अनुसार बदलते हैं, और नींद आपकी नींद की ज़रूरत के अनुसार रहती है। इन्हें कभी भी सेटिंग › लक्ष्य में बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli obiettivi si adattano ogni lunedì in base ai tuoi progressi e il sonno segue il tuo fabbisogno di sonno. Puoi modificarli in qualsiasi momento in Impostazioni › Obiettivi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As metas se ajustam toda segunda-feira com base no seu progresso, e o sono acompanha sua necessidade de sono. Altere-as quando quiser em Ajustes › Metas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цели меняются каждый понедельник по вашему прогрессу, а цель по сну следует вашей потребности во сне. Изменить их можно в любое время в «Настройки › Цели»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标会在每周一根据你的进展调整，睡眠目标则跟随你的睡眠需求。可随时在“设置 › 目标”中更改。"
          }
        }
      }
    },
    "Goals adjust every Monday: up 5% after a week you met them, down 5% after a week you missed them. A goal you change holds for a week, then adjusts from your value." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele werden jeden Montag angepasst: um 5 % nach oben nach einer Woche, in der du sie erreicht hast, um 5 % nach unten nach einer Woche, in der du sie verfehlt hast. Ein von dir geändertes Ziel bleibt eine Woche bestehen und wird dann von deinem Wert aus angepasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los objetivos se ajustan cada lunes: suben un 5% tras una semana en que los cumpliste y bajan un 5% tras una semana en que no. Un objetivo que cambias se mantiene una semana y luego se ajusta a partir de tu valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les objectifs s’ajustent chaque lundi : +5 % après une semaine où vous les avez atteints, −5 % après une semaine où vous les avez manqués. Un objectif que vous modifiez est maintenu une semaine, puis s’ajuste à partir de votre valeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य हर सोमवार समायोजित होते हैं: जिस सप्ताह आपने उन्हें पूरा किया उसके बाद 5% बढ़ते हैं, जिस सप्ताह चूके उसके बाद 5% घटते हैं। आपका बदला हुआ लक्ष्य एक सप्ताह टिकता है, फिर आपके मान से समायोजित होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli obiettivi si adattano ogni lunedì: +5% dopo una settimana in cui li hai raggiunti, −5% dopo una in cui non ci sei riuscito. Un obiettivo che modifichi resta fisso per una settimana, poi si adatta partendo dal tuo valore."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As metas se ajustam toda segunda-feira: sobem 5% após uma semana em que você as cumpriu e descem 5% após uma semana em que não as cumpriu. Uma meta que você altera vale por uma semana e depois se ajusta a partir do seu valor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цели меняются каждый понедельник: на 5% выше после недели, когда вы их выполнили, и на 5% ниже после недели, когда не выполнили. Изменённая вами цель сохраняется неделю, затем корректируется от вашего значения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标会在每周一调整：一周内达成目标则上调 5%，未达成则下调 5%。你更改的目标会保持一周，之后根据你设定的值调整。"
          }
        }
      }
    },
    "Good" : {
