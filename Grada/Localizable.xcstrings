          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ Schlaf vor deinem %@ um %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para %@ de sueño antes de tu %@ a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour %@ de sommeil avant votre %@ à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ पर आपके %2$@ से पहले %1$@ की नींद के लिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per %1$@ di sonno prima del tuo %2$@ alle %3$@."
          }
        },
        "pt" : {
          "stringUnit" : {
