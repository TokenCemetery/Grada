    "Cycle length varies within a person, so the next period is a range, not a date" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zykluslänge schwankt bei jeder Person, daher ist die nächste Periode ein Zeitraum, kein Datum"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La duración del ciclo varía en cada persona, así que la próxima regla es un rango, no una fecha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durée du cycle varie chez une même personne : les prochaines règles sont une plage, pas une date"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही व्यक्ति में चक्र की लंबाई बदलती है, इसलिए अगला पीरियड एक तारीख नहीं, एक सीमा है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durata del ciclo varia nella stessa persona, quindi le prossime mestruazioni sono un intervallo, non una data"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A duração do ciclo varia na mesma pessoa, então a próxima menstruação é um intervalo, não uma data"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длина цикла у одного человека меняется, поэтому следующая менструация — диапазон, а не дата"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一个人的周期长度会变化，所以下次经期是一个范围，而不是某一天"
          }
        }
      }
    },
    "cycle.period" : {
      "comment" : "Menstrual period, logged without an amount of flow",
      "localizations" : {
