    "%@ steps to today's goal of %@. A brisk walk is about %@ steps a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch %@ Schritte bis zum heutigen Ziel von %@. Zügiges Gehen sind etwa %@ Schritte pro Minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pasos para el objetivo de hoy de %@. Un paseo a buen ritmo son unos %@ pasos por minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pas pour atteindre l’objectif du jour de %@. Une marche rapide représente environ %@ pas par minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज के %2$@ कदम के लक्ष्य के लिए %1$@ कदम बाकी हैं। तेज़ चाल में लगभग %3$@ कदम प्रति मिनट होते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passi all’obiettivo di oggi di %@. Una camminata veloce è di circa %@ passi al minuto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam %1$@ passos para a meta de hoje, de %2$@. Uma caminhada rápida tem cerca de %3$@ passos por minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ шагов до сегодняшней цели в %@. Быстрая ходьба — около %@ шагов в минуту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距今日 %2$@ 步的目标还差 %1$@ 步。快走约每分钟 %3$@ 步。"
          }
        }
      }
    },
    "%@ steps today, %@ over your goal of %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Schritte heute, %@ über deinem Ziel von %@."
